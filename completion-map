<body>
<div class="wrap">
<header>
  <div class="eyebrow">
    <span class="eyebrow-dot"></span>
    Repository Completion Map
  </div>
  <div class="header-row">
    <div>
      <h1 id="pageTitle">Your Road to 100%</h1>
      <p class="subtitle">
        A visual map of the repository cleanup journey.
        Every decision moves the portfolio closer to completion.
      </p>
    </div>
    <div class="live-status">
      <span class="live-status-label">System Status</span>
      <span class="live-status-value" id="systemStatus">
        CONNECTING…
      </span>
    </div>
  </div>
</header>
<section class="progress-section">
  <div class="progress-top">
    <div>
      <div class="progress-title">
        Overall completion
      </div>
    </div>
    <div class="percent">
      <span id="percentNumber">0</span><span>%</span>
    </div>
  </div>
  <div class="progress-track">
    <div class="progress-fill" id="progressFill"></div>
  </div>
  <div class="milestones">
    <div class="milestone" data-percent="0">
      START
    </div>
    <div class="milestone" data-percent="25">
      25% — ORGANIZE
    </div>
    <div class="milestone" data-percent="50">
      50% — BUILD
    </div>
    <div class="milestone" data-percent="75">
      75% — POLISH
    </div>
    <div class="milestone" data-percent="100">
      100% — COMPLETE
    </div>
  </div>
</section>
<section class="map-shell">
  <div class="map-header">
    <span class="map-header-title">
      Completion Route
    </span>
    <span class="map-header-note" id="mapNote">
      Calculating route…
    </span>
  </div>
  <div class="map" id="map">
    <div class="road">
      <div
        class="road-progress"
        id="roadProgress">
      </div>
    </div>
    <div
      class="traveler"
      id="traveler">
    </div>
    <div class="stop stop-0" data-stop="0">
      <div class="stop-dot">
        0
      </div>
      <div class="stop-label">
        START
      </div>
    </div>
    <div class="stop stop-25" data-stop="25">
      <div class="stop-dot">
        25
      </div>
      <div class="stop-label">
        ORGANIZE
      </div>
    </div>
    <div class="stop stop-50" data-stop="50">
      <div class="stop-dot">
        50
      </div>
      <div class="stop-label">
        BUILD
      </div>
    </div>
    <div class="stop stop-75" data-stop="75">
      <div class="stop-dot">
        75
      </div>
      <div class="stop-label">
        POLISH
      </div>
    </div>
    <div class="stop stop-100" data-stop="100">
      <div class="stop-dot">
        100
      </div>
      <div class="stop-label">
        COMPLETE
      </div>
    </div>
    <div
      class="work-callout hidden"
      id="workCallout">
      <div class="callout-eyebrow">
        Next checkpoint
      </div>
      <div
        class="callout-main"
        id="calloutMain">
        THIS IS 70% COMPLETE
      </div>
      <div
        class="callout-detail"
        id="calloutDetail">
        Work on the repositories below to move forward.
      </div>
      <div class="callout-arrow"></div>
    </div>
    <div
      class="repo-layer"
      id="repoLayer">
    </div>
  </div>
</section>
<section class="stats">
  <div class="stat">
    <div class="stat-num" id="statTotal">0</div>
    <div class="stat-label">Repositories</div>
  </div>
  <div class="stat done">
    <div class="stat-num" id="statReviewed">0</div>
    <div class="stat-label">Reviewed</div>
  </div>
  <div class="stat work">
    <div class="stat-num" id="statWork">0</div>
    <div class="stat-label">Need Work</div>
  </div>
  <div class="stat danger">
    <div class="stat-num" id="statUnassigned">0</div>
    <div class="stat-label">Unassigned</div>
  </div>
</section>
<section class="section">
  <div class="section-heading">
    <h2>
      Work On Me
    </h2>
    <div class="section-rule"></div>
  </div>
  <div
    class="queue"
    id="workQueue">
  </div>
</section>
<div class="controls">
  <div class="button-group">
    <button
      class="btn primary"
      id="refreshBtn">
      Refresh Map
    </button>
    <button
      class="btn"
      id="openCommandBtn">
      Open Command Center
    </button>
  </div>
  <div
    class="last-saved"
    id="lastSaved">
    Reading local progress…
  </div>
</div>
<footer>
  <span>
    GitHub repository data · local progress memory
  </span>
  <span>
    Completion Map
  </span>
</footer>
</div>
<script>
/* =========================================================
   CONFIGURATION
========================================================= */
const USERNAME = "fairefaretravels";
/*
  MUST MATCH THE CLEANUP COMMAND CENTER
*/
const STORAGE_KEY =
  "repository-cleanup-command-center-v1";
const SETTINGS_KEY =
  "repository-cleanup-settings-v1";
/* =========================================================
   STATE
========================================================= */
let allRepos = [];
let decisions = {};
let mergeReady = {};
let currentPercent = 0;
/* =========================================================
   HELPERS
========================================================= */
const el = id =>
  document.getElementById(id);
function escapeHTML(value){
  return String(value || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}
/*
  Same review definition used by the
  Cleanup Command Center.
*/
function isReviewed(d){
  if(!d) return false;
  if(
    !d.action ||
    !d.group ||
    !d.backend
  ){
    return false;
  }
  if(
    d.action === "MERGE" &&
    !d.mergeTarget
  ){
    return false;
  }
  return true;
}
/* =========================================================
   LOCAL STORAGE
========================================================= */
function loadLocalState(){
  try{
    const raw =
      localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed =
        JSON.parse(raw);
      decisions =
        parsed.decisions || {};
      mergeReady =
        parsed.mergeReady || {};
    }
    return true;
  }catch(error){
    console.warn(
      "Could not read cleanup state:",
      error
    );
    decisions = {};
    mergeReady = {};
    return false;
  }
}
function getSavedTimestamp(){
  try{
    const raw =
      localStorage.getItem(STORAGE_KEY);
    if(!raw) return null;
    const parsed =
      JSON.parse(raw);
    return parsed.savedAt || null;
  }catch(error){
    return null;
  }
}
/* =========================================================
   PROGRESS
========================================================= */
function calculateProgress(){
  if(!allRepos.length){
    return 0;
  }
  const reviewed =
    allRepos.filter(repo =>
      isReviewed(decisions[repo.id])
    ).length;
  return Math.round(
    (reviewed / allRepos.length) * 100
  );
}
/* =========================================================
   STATUS
========================================================= */
function getRepoStatus(repo){
  const d =
    decisions[repo.id];
  if(!d || !isReviewed(d)){
    return {
      type:"WORK",
      label:"Needs work"
    };
  }
  return {
    type:"DONE",
    label:d.action || "Reviewed"
  };
}
function getSuggestion(repo){
  const d =
    decisions[repo.id];
  if(!d){
    return {
      action:"REVIEW",
      text:"Review this repository"
    };
  }
  if(!d.action){
    return {
      action:"ASSIGN ACTION",
      text:"Choose Keep, Merge, Archive or Duplicate"
    };
  }
  if(!d.group){
    return {
      action:"ASSIGN GROUP",
      text:"Assign a repository group"
    };
  }
  if(!d.backend){
    return {
      action:"ASSIGN BACKEND",
      text:"Mark Firebase or No Firebase"
    };
  }
  if(
    d.action === "MERGE" &&
    !d.mergeTarget
  ){
    return {
      action:"SET TARGET",
      text:"Choose the repository to merge into"
    };
  }
  return {
    action:"REVIEWED",
    text:"Ready for the next stage"
  };
}
/* =========================================================
   MAP POSITION
========================================================= */
function getMapPosition(index,total){
  if(total <= 1){
    return {
      x:50,
      y:"50%"
    };
  }
  /*
    Spread nodes across the route.
  */
  const progress =
    index / (total - 1);
  const x =
    8 + (progress * 84);
  /*
    Alternate above/below road.
  */
  const side =
    index % 2 === 0
      ? "above"
      : "below";
  return {
    x,
    side
  };
}
/* =========================================================
   RENDER PROGRESS
========================================================= */
function renderProgress(){
  const percent =
    calculateProgress();
  currentPercent =
    percent;
  el("percentNumber")
    .textContent = percent;
  el("progressFill")
    .style.width =
      percent + "%";
  /*
    Desktop route
  */
  if(window.innerWidth > 760){
    el("roadProgress")
      .style.width =
        percent + "%";
    el("traveler")
      .style.left =
        `calc(7% + (${percent} * .86%))`;
  }else{
    /*
      Mobile route is vertical.
    */
    el("roadProgress")
      .style.height =
        percent + "%";
    el("traveler")
      .style.top =
        `calc(7% + (${percent} * .86%))`;
  }
  document
    .querySelectorAll(".milestone")
    .forEach(milestone => {
      const value =
        Number(
          milestone.dataset.percent
        );
      milestone.classList.toggle(
        "active",
        percent >= value
      );
    });
  document
    .querySelectorAll(".stop")
    .forEach(stop => {
      const value =
        Number(
          stop.dataset.stop
        );
      stop.classList.toggle(
        "done",
        percent >= value
      );
      stop.classList.toggle(
        "current",
        percent < value &&
        percent >= value - 25
      );
    });
  updateCallout(percent);
}
/* =========================================================
   CALLOUT
========================================================= */
function updateCallout(percent){
  const callout =
    el("workCallout");
  if(percent >= 100){
    callout.classList.remove("hidden");
    el("calloutMain")
      .textContent =
        "100% COMPLETE";
    el("calloutDetail")
      .textContent =
        "The repository cleanup route is complete.";
    return;
  }
  if(percent >= 50){
    callout.classList.remove("hidden");
    el("calloutMain")
      .textContent =
        `THIS IS ${percent}% COMPLETE`;
    const remaining =
      allRepos.length -
      allRepos.filter(repo =>
        isReviewed(decisions[repo.id])
      ).length;
    el("calloutDetail")
      .textContent =
        `${remaining} repository${remaining === 1 ? "" : "ies"} still need attention. Work on me.`;
  }else{
    callout.classList.add("hidden");
  }
}
/* =========================================================
   REPOSITORY NODES
========================================================= */
function renderRepoNodes(){
  const layer =
    el("repoLayer");
  layer.innerHTML = "";
  /*
    Only display up to 16 nodes on the map.
    The work queue below still shows everything.
  */
  const visible =
    allRepos
      .slice()
      .sort((a,b)=>{
        const aDone =
          isReviewed(decisions[a.id]);
        const bDone =
          isReviewed(decisions[b.id]);
        if(aDone !== bDone){
          return aDone ? 1 : -1;
        }
        return a.name
          .localeCompare(b.name);
      })
      .slice(0,16);
  visible.forEach((repo,index)=>{
    const position =
      getMapPosition(
        index,
        visible.length
      );
    const status =
      getRepoStatus(repo);
    const suggestion =
      getSuggestion(repo);
    const node =
      document.createElement("div");
    node.className =
      "repo-node " +
      (
        position.side === "above"
          ? "node-above"
          : "node-below"
      );
    node.style.left =
      position.x + "%";
    node.style.setProperty(
      "--node-y",
      `${20 + (index % 5) * 15}%`
    );
    const statusColor =
      status.type === "DONE"
        ? "var(--green)"
        : "var(--gold)";
    node.innerHTML = `
      <div class="node-name">
        ${escapeHTML(repo.name)}
      </div>
      <div
        class="node-status"
        style="color:${statusColor}">
        <span
          class="status-dot"
          style="background:${statusColor}">
        </span>
        ${escapeHTML(status.label)}
      </div>
      <div class="node-suggestion">
        ${escapeHTML(suggestion.action)}
        ·
        ${escapeHTML(suggestion.text)}
      </div>
    `;
    node.addEventListener(
      "click",
      ()=>{
        window.open(
          repo.html_url,
          "_blank",
          "noopener"
        );
      }
    );
    layer.appendChild(node);
  });
}
/* =========================================================
   WORK QUEUE
========================================================= */
function renderWorkQueue(){
  const queue =
    el("workQueue");
  queue.innerHTML = "";
  const work =
    allRepos.filter(repo =>
      !isReviewed(decisions[repo.id])
    );
  /*
    Prioritize repositories with
    partial decisions first.
  */
  work.sort((a,b)=>{
    const da =
      decisions[a.id] || {};
    const db =
      decisions[b.id] || {};
    const score = d => {
      let value = 0;
      if(d.action) value++;
      if(d.group) value++;
      if(d.backend) value++;
      if(d.mergeTarget) value++;
      return value;
    };
    return score(db) - score(da);
  });
  if(work.length === 0){
    queue.innerHTML = `
      <div class="queue-card">
        <div class="queue-name">
          Nothing left to work on.
        </div>
        <div class="queue-message">
          Every repository has been fully reviewed.
        </div>
        <span class="queue-action">
          100% COMPLETE
        </span>
      </div>
    `;
    return;
  }
  work.slice(0,12)
    .forEach(repo=>{
      const suggestion =
        getSuggestion(repo);
      const card =
        document.createElement("div");
      const isCritical =
        !decisions[repo.id];
      card.className =
        "queue-card" +
        (
          isCritical
            ? " critical"
            : ""
        );
      card.innerHTML = `
        <div class="queue-name">
          ${escapeHTML(repo.name)}
        </div>
        <div class="queue-message">
          ${escapeHTML(
            suggestion.text
          )}
        </div>
        <span class="queue-action">
          ${escapeHTML(
            suggestion.action
          )}
        </span>
      `;
      card.addEventListener(
        "click",
        ()=>{
          window.open(
            repo.html_url,
            "_blank",
            "noopener"
          );
        }
      );
      queue.appendChild(card);
    });
  if(work.length > 12){
    const more =
      document.createElement("div");
    more.className =
      "queue-card";
    more.innerHTML = `
      <div class="queue-name">
        +${work.length - 12} more
      </div>
      <div class="queue-message">
        Open the Command Center to see every repository.
      </div>
    `;
    queue.appendChild(more);
  }
}
/* =========================================================
   STATS
========================================================= */
function renderStats(){
  const total =
    allRepos.length;
  const reviewed =
    allRepos.filter(repo =>
      isReviewed(decisions[repo.id])
    ).length;
  const work =
    total - reviewed;
  const unassigned =
    allRepos.filter(repo => {
      const d =
        decisions[repo.id];
      return !d ||
        (
          !d.action &&
          !d.group &&
          !d.backend
        );
    }).length;
  el("statTotal")
    .textContent = total;
  el("statReviewed")
    .textContent = reviewed;
  el("statWork")
    .textContent = work;
  el("statUnassigned")
    .textContent = unassigned;
  if(work === 0){
    el("systemStatus")
      .textContent =
        "100% COMPLETE";
    el("systemStatus")
      .style.color =
        "var(--green)";
  }else{
    el("systemStatus")
      .textContent =
        `${work} REPOSITORIES NEED WORK`;
    el("systemStatus")
      .style.color =
        "var(--gold)";
  }
  el("mapNote")
    .textContent =
      `${reviewed} of ${total} reviewed`;
}
/* =========================================================
   SAVED STATUS
========================================================= */
function renderSavedStatus(){
  const timestamp =
    getSavedTimestamp();
  if(!timestamp){
    el("lastSaved")
      .textContent =
        "No cleanup decisions saved yet.";
    return;
  }
  const date =
    new Date(timestamp);
  el("lastSaved")
    .textContent =
      "Last saved: " +
      date.toLocaleString();
}
/* =========================================================
   LOAD GITHUB
========================================================= */
async function loadRepositories(){
  el("systemStatus")
    .textContent =
      "LOADING GITHUB…";
  try{
    const response =
      await fetch(
        `https://api.github.com/users/${USERNAME}/repos?per_page=100&sort=updated`
      );
    if(response.status === 403){
      throw new Error(
        "GitHub API rate limit reached."
      );
    }
    if(!response.ok){
      throw new Error(
        "GitHub could not be reached."
      );
    }
    allRepos =
      await response.json();
    el("systemStatus")
      .textContent =
        "LIVE · GITHUB CONNECTED";
    renderEverything();
  }catch(error){
    console.error(error);
    el("systemStatus")
      .textContent =
        "GITHUB CONNECTION ERROR";
    el("systemStatus")
      .style.color =
        "var(--red)";
    el("mapNote")
      .textContent =
        "Could not load repositories";
    el("workQueue")
      .innerHTML = `
        <div class="queue-card critical">
          <div class="queue-name">
            GitHub connection problem
          </div>
          <div class="queue-message">
            ${escapeHTML(error.message)}
          </div>
        </div>
      `;
  }
}
/* =========================================================
   RENDER EVERYTHING
========================================================= */
function renderEverything(){
  renderProgress();
  renderRepoNodes();
  renderWorkQueue();
  renderStats();
  renderSavedStatus();
}
/* =========================================================
   BUTTONS
========================================================= */
el("refreshBtn")
  .addEventListener(
    "click",
    async ()=>{
      loadLocalState();
      await loadRepositories();
    }
  );
el("openCommandBtn")
  .addEventListener(
    "click",
    ()=>{
      /*
        Change this path if your
        command center has a different
        filename.
      */
      window.location.href =
        "index.html";
    }
  );
/* =========================================================
   RESPONSIVE MAP UPDATE
========================================================= */
window.addEventListener(
  "resize",
  ()=>{
    renderProgress();
  }
);
/* =========================================================
   INITIALIZE
========================================================= */
async function init(){
  loadLocalState();
  await loadRepositories();
}
/* =========================================================
   START
========================================================= */
init();
</script>
</body>
